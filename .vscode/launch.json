{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug RecipeApp",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/NutriTrack/main.go",
            "buildFlags": "-gcflags=\"all=-N -l\"",
            "env": {
                "CGO_ENABLED": "1"
            },
            "args": [],
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "127.0.0.1:3000",
                "uriFormat": "http://127.0.0.1:3000"
            }
        },
        {
            "name": "Debug Nutrient API",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/nutrient-api/main.go",
            "buildFlags": "-gcflags=\"all=-N -l\"",
            "env": {
                "CGO_ENABLED": "1"
            },
            "args": []
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug (App + API)",
            "configurations": [
                "Debug RecipeApp",
                "Debug Nutrient API"
            ]
        }
    ]
}
